PORT=3000

# Origenes permitidos para CORS (separados por coma). Deben coincidir con los
# puertos usados en desarrollo/produccion para el frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nextproject
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=8h
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Secreto independiente de JWT_SECRET, exclusivo para tokens de enlace publico de cotizaciones (Fase de vista de cliente)
COTIZACION_LINK_SECRET=

# Datos bancarios para mostrar al cliente cuando el metodo de anticipo es
# TRANSFERENCIA (Fase D). PENDIENTES: sin valores todavia, no se inventan.
# Mientras no esten configuradas, el backend debe mostrar un aviso generico
# en lugar de datos bancarios.
BANCO_NOMBRE=
BANCO_TIPO_CUENTA=
BANCO_NUMERO_CUENTA=
BANCO_TITULAR=
BANCO_RUC=
