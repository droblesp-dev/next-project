PORT=3000

# Origenes permitidos para CORS (separados por coma). Deben coincidir con los
# puertos usados en desarrollo/produccion para el frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nextproject
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=8h
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Secreto independiente de JWT_SECRET, exclusivo para tokens de enlace publico de cotizaciones (Fase de vista de cliente)
COTIZACION_LINK_SECRET=

# Secreto independiente de JWT_SECRET y COTIZACION_LINK_SECRET, exclusivo para los enlaces de solicitud de leads TIBIO (vigencia 7 dias, uso unico)
LEAD_LINK_SECRET=

# Correo del OPERATIVO responsable por defecto de las ORDENES NUEVAS. Debe existir, estar activo y tener rol OPERATIVO;
# si no, la orden no se crea (409). No afecta a las ordenes ya existentes.
OPERATIVO_POR_DEFECTO_EMAIL=

# Datos bancarios para mostrar al cliente cuando el metodo de anticipo es
# TRANSFERENCIA (Fase D). PENDIENTES: sin valores todavia, no se inventan.
# Mientras no esten configuradas, el backend debe mostrar un aviso generico
# en lugar de datos bancarios.
BANCO_NOMBRE=
BANCO_TIPO_CUENTA=
BANCO_NUMERO_CUENTA=
BANCO_TITULAR=
BANCO_RUC=

# Contraseñas para el seeder de usuarios de prueba (uno por rol), usado por
# scripts/seed-usuarios-roles.ts. Definir un valor propio antes de correrlo;
# no se inventan valores por defecto.
SEED_ADMIN_PASSWORD=
SEED_COMERCIAL_PASSWORD=
SEED_OPERATIVO_PASSWORD=

# SOLICITUD-RECUPERACION-01B: correo transaccional de confirmación de
# solicitud, vía Brevo Transactional Email API (HTTP directo, sin SDK).
# Mientras BREVO_API_KEY o NEXT_PROJECT_EMAIL falten, el envío queda
# "skipped" (registrado en logs) — la solicitud se sigue creando con 201
# normalmente, nunca se bloquea por esto.
#
# BREVO_API_KEY: clave real de la cuenta Brevo. PENDIENTE — no se inventa.
BREVO_API_KEY=
# NEXT_PROJECT_EMAIL: remitente REAL, VERIFICADO en Brevo (Senders & IP /
# dominio autenticado). Enviar con un remitente no verificado es rechazado
# por Brevo — no asumir que cualquier correo sirve. PENDIENTE — no se
# inventa.
NEXT_PROJECT_EMAIL=
# BREVO_SANDBOX: "true" agrega el header X-Sib-Sandbox: drop (Brevo acepta
# la petición pero NO entrega el correo) — usar únicamente para validar la
# integración antes de un envío real. "false" o vacío = envío real.
BREVO_SANDBOX=false

# NEXT_PROJECT_NAME / NEXT_PROJECT_WHATSAPP (SOLICITUD-RECUPERACION-01A/B):
# mismos valores ya centralizados en el frontend (frontend/src/lib/config.ts)
# — el backend necesita su propia copia porque corre en un proceso distinto.
# Opcionales: si no se definen, se usan los valores ya verificados y en uso
# ("NextProject" / "593939067666"), nunca inventados.
NEXT_PROJECT_NAME=NextProject
NEXT_PROJECT_WHATSAPP=593939067666
