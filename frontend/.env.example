# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL (FORMULARIO-01): URL base del backend NEXTPROJECT que
# usa TODO el frontend (login, área privada y formulario público). Opcional
# en desarrollo local: si no se define, se usa "http://localhost:3000" (el
# mismo valor que ya se usaba antes, hardcodeado). Definirla es necesario
# únicamente para desplegar el frontend contra un backend en otro dominio.
#
# Despliegue vía Docker (frontend/Dockerfile + nginx.conf.template): dejar
# esta variable en "" (vacío) al construir la imagen (--build-arg
# VITE_API_BASE_URL=""), para que el frontend llame rutas relativas
# ("/api/...") que nginx reenvía al backend (ver BACKEND_HOST/BACKEND_PORT
# más abajo). No usar localhost:3000 en producción: ese puerto no existe
# fuera del contenedor del backend.
VITE_API_BASE_URL="http://localhost:3000"

# BACKEND_HOST / BACKEND_PORT: NO son variables de Vite (no llevan prefijo
# VITE_) — las lee nginx en tiempo de arranque del contenedor del frontend
# (frontend/nginx.conf.template), no el código de React. Definen a dónde
# reenvía nginx las peticiones "/api/*". Se pasan con `docker run -e` (o el
# equivalente del orquestador), no en este archivo .env del frontend.
# Por defecto en el Dockerfile: BACKEND_HOST=backend, BACKEND_PORT=3000.

# VITE_NEXT_PROJECT_WHATSAPP / VITE_NEXT_PROJECT_NAME (SOLICITUD-RECUPERACION-01A):
# número de WhatsApp oficial y nombre de marca de NextProject, usados por los
# enlaces wa.me del formulario público (antes repetidos como literal 4 veces
# en App.tsx). Opcionales: si no se definen, se usan los valores ya
# verificados y en uso ("593939067666" / "NextProject") — mismo patrón que
# VITE_API_BASE_URL arriba.
VITE_NEXT_PROJECT_WHATSAPP="593939067666"
VITE_NEXT_PROJECT_NAME="NextProject"
